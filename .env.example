# Shared admin catalogue — required for edits to appear on every phone and browser.
# Create a free project at https://supabase.com, run supabase-catalog.sql in SQL Editor,
# then paste your project values below into your hosting provider (Vercel, etc.).

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-service-role-or-secret-key

# Optional overrides
# SUPABASE_CATALOG_TABLE=soul_catalog
# SUPABASE_CATALOG_ID=default
