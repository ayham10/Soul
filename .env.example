# Shared admin catalogue — required for edits to appear on every phone and browser.
# Create a free project at https://supabase.com, then run in SQL Editor:
#   1. supabase-catalog.sql
#   2. supabase-storage.sql

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-service-role-or-secret-key

# Admin authentication (server-side only — required for catalog writes and image upload/delete)
# Keep the existing production passcode until you intentionally rotate it.
ADMIN_PASSCODE=soul2024
CATALOG_SESSION_SECRET=generate-a-random-secret-at-least-32-characters-long

# Optional overrides
# SUPABASE_CATALOG_TABLE=soul_catalog
# SUPABASE_CATALOG_ID=default
